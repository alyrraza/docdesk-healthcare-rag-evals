# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# local, test or production. Production turns off /docs, /redoc and /openapi.json.
ENVIRONMENT=local
# Uploaded files and the embedding model; both folders are git-ignored.
UPLOAD_DIR=data/uploads
MODEL_DIR=.cache/models/all-MiniLM-L6-v2
MAX_UPLOAD_BYTES=5000000
DATABASE_URL=postgresql://user:change-me@localhost:5432/docdesk
READONLY_DATABASE_URL=postgresql+psycopg://docdesk_readonly:change-me@localhost:5432/docdesk
REDIS_URL=redis://localhost:6379/0
# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_LIFETIME_MINUTES=30
# Used only by scripts/seed_admin.py. Pick a password of at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-change-me
# Free-tier LLM keys. Leave empty to run without them; only scripts/smoke_llm.py needs them.
GROQ_API_KEY=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=
# Model ids, fixed in config and logged with every result. Generator and judge must differ.
GENERATOR_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=qwen/qwen3.8-27b
CROSSCHECK_JUDGE_MODEL=google/gemma-4-31b-it:free
CROSSCHECK_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
