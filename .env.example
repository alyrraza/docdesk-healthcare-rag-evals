# Copy to .env or, better, run: python scripts/make_env.py
# That command writes .env with random secrets. .env is git-ignored. Never commit real values.
# Every secret below must be replaced: the API refuses to start while one still holds a
# placeholder word such as change-me.

# local, test or production. Production turns off /docs, /redoc and /openapi.json.
ENVIRONMENT=local
# Folder for uploaded files. Git-ignored. Docker compose uses a named volume instead.
UPLOAD_DIR=data/uploads
# Folder with the pinned embedding model. Fill it with: python scripts/fetch_model.py
MODEL_DIR=.cache/models/all-MiniLM-L6-v2
# Largest accepted upload in bytes.
MAX_UPLOAD_BYTES=5000000

# Password of the Postgres user "docdesk". Used by docker compose and by DATABASE_URL below.
POSTGRES_PASSWORD=change-me
# Password of the read-only database role that the SQL branch logs in with.
READONLY_PASSWORD=change-me
# Main database, for a local run outside Docker. Compose builds its own url from the passwords.
DATABASE_URL=postgresql+psycopg://docdesk:change-me@localhost:5432/docdesk
# Login of the read-only role. Alembic sets this role's password from here.
READONLY_DATABASE_URL=postgresql+psycopg://docdesk_readonly:change-me@localhost:5432/docdesk
# Broker and result store for the ingestion worker.
REDIS_URL=redis://localhost:6379/0

# Signs login tokens. At least 32 characters.
JWT_SECRET=change-me
# How long a login token lives, in minutes.
JWT_LIFETIME_MINUTES=30
# First admin account, created by scripts/seed_admin.py and scripts/demo_seed.py.
ADMIN_EMAIL=admin@example.com
# Admin password, at least 12 characters.
ADMIN_PASSWORD=change-me

# Your own Groq key. Needed only to generate answers. Retrieval works without it, and POST /query
# answers with a clear 503 until a key is set. Get one at https://console.groq.com
GROQ_API_KEY=
# Optional second Groq key of the same owner, used by the eval key pool only.
GROQ_API_KEY_2=
# Optional, used only by the judge calibration cross check.
OPENROUTER_API_KEY=

# Model ids, fixed in config and logged with every result. Generator and judge must differ.
GENERATOR_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=qwen/qwen3.8-27b
# Free models only, for the 40 item judge calibration cross check.
CROSSCHECK_JUDGE_MODEL=google/gemma-4-31b-it:free
CROSSCHECK_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
